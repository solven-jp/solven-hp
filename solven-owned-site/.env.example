# Schema-only example. Copy outside Git, then replace placeholders with approved reference names.
SOLVEN_RUNTIME_ENVIRONMENT=staging
SOLVEN_PUBLIC_ORIGIN=https://staging.example.invalid
SOLVEN_ALLOWED_HOSTS=staging.example.invalid
SOLVEN_TRUSTED_PROXY_MODE=edge
SOLVEN_TRUSTED_PROXY_ADDRESSES=
SOLVEN_REQUIRE_HTTPS=true
SOLVEN_SECURE_COOKIES=true
SOLVEN_COOKIE_SAME_SITE=Strict
SOLVEN_SESSION_COOKIE_NAME=solven_staging_session
SOLVEN_SESSION_TRANSPORT=header
SOLVEN_SESSION_TTL_SECONDS=1800
SOLVEN_CSRF_ENABLED=true
SOLVEN_MAX_BODY_BYTES=32768
SOLVEN_CORS_MODE=same-origin
SOLVEN_HSTS_MAX_AGE=31536000
SOLVEN_HSTS_INCLUDE_SUBDOMAINS=false
SOLVEN_LOG_PII=false
SOLVEN_INCIDENT_CORRELATION_HEADER=x-request-id
SOLVEN_LEAD_STORE_ADAPTER=staging-approved
SOLVEN_OUTBOX_ADAPTER=staging-approved
SOLVEN_NOTIFICATION_ADAPTER=disabled
SOLVEN_SESSION_ADAPTER=distributed-approved
SOLVEN_RATE_LIMITER_ADAPTER=edge-approved
SOLVEN_FIRESTORE_PROJECT_ID=solven-owned-site-stg-d3e6
SOLVEN_SECRET_MANAGER_REF=staging/secret-manager-reference
SOLVEN_SECRET_NAMESPACE=staging/solven-owned-site
SOLVEN_LEAD_STORE_SECRET_REF=staging/lead-store-reference
SOLVEN_NOTIFICATION_SECRET_REF=staging/notification-reference
SOLVEN_NOTIFICATION_DESTINATION_REF=staging/notification-destination-reference
SOLVEN_GA4_ENABLED=false
SOLVEN_GA4_MEASUREMENT_ID_REF=staging/ga4-reference-not-used
SOLVEN_RETENTION_DAYS=30
SOLVEN_BACKUP_TARGET_REF=staging/backup-reference
SOLVEN_STAGING=true
SOLVEN_NOINDEX=true
SOLVEN_RELEASE_ID=replace-with-release-id
SOLVEN_SOURCE_COMMIT_SHA=0000000
